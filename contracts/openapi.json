{
  "openapi": "3.1.0",
  "info": {
    "title": "Signal Lab API",
    "version": "0.1.0-demo",
    "description": "docs/planning/08-api-data-contract.md를 구현한 fixture 기반 계약 검증용 API입니다. 실제 인증·공급자·결제 연동 전용 sandbox입니다."
  },
  "servers": [{ "url": "http://localhost:4173" }],
  "tags": [
    { "name": "Market" },
    { "name": "Stocks" },
    { "name": "Signals" },
    { "name": "Screener" },
    { "name": "Watchlists" },
    { "name": "Subscriptions" },
    { "name": "Stream" },
    { "name": "Authentication" },
    { "name": "Operations" }
  ],
  "paths": {
    "/healthz": { "get": { "tags": ["Operations"], "responses": { "200": { "description": "프로세스 liveness", "content": { "application/json": { "schema": { "type": "object", "required": ["status", "service", "requestId"], "properties": { "status": { "const": "ok" }, "service": { "type": "string" }, "requestId": { "type": "string" }, "traceId": { "type": "string" } } } } } } } } },
    "/readyz": { "get": { "tags": ["Operations"], "responses": { "200": { "description": "샌드박스 또는 운영 의존성이 준비됨", "content": { "application/json": { "$ref": "#/components/schemas/Readiness" } } }, "503": { "description": "운영 의존성 또는 출시 게이트 미충족", "content": { "application/json": { "$ref": "#/components/schemas/Readiness" } } } } } },
    "/internal/metrics": { "get": { "tags": ["Operations"], "parameters": [{ "$ref": "#/components/parameters/MetricsToken" }], "responses": { "200": { "description": "Prometheus text exposition", "content": { "text/plain": { "schema": { "type": "string" } } } }, "401": { "$ref": "#/components/responses/Error" }, "503": { "$ref": "#/components/responses/Error" } } } },
    "/api/v1/auth/demo/session": { "post": { "tags": ["Authentication"], "description": "Development-only sandbox session. Production uses an approved provider adapter.", "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DemoSessionRequest" } } } }, "responses": { "201": { "$ref": "#/components/responses/AuthSession" }, "default": { "$ref": "#/components/responses/Error" } } } },
    "/api/v1/auth/me": { "get": { "tags": ["Authentication"], "security": [{ "sessionCookie": [] }, {}], "responses": { "200": { "$ref": "#/components/responses/AuthMe" }, "default": { "$ref": "#/components/responses/Error" } } } },
    "/api/v1/auth/logout": { "post": { "tags": ["Authentication"], "security": [{ "sessionCookie": [] }, { "demoMember": [] }], "parameters": [{ "$ref": "#/components/parameters/CsrfToken" }], "responses": { "200": { "$ref": "#/components/responses/AuthMe" }, "default": { "$ref": "#/components/responses/Error" } } } },
    "/api/v1/market/overview": { "get": { "tags": ["Market"], "responses": { "200": { "$ref": "#/components/responses/MarketOverview" }, "default": { "$ref": "#/components/responses/Error" } } } },
    "/api/v1/stocks/search": { "get": { "tags": ["Stocks"], "parameters": [{ "$ref": "#/components/parameters/SearchQuery" }, { "$ref": "#/components/parameters/ListCursor" }], "responses": { "200": { "$ref": "#/components/responses/StockSearch" }, "default": { "$ref": "#/components/responses/Error" } } } },
    "/api/v1/stocks/{ticker}": { "get": { "tags": ["Stocks"], "parameters": [{ "$ref": "#/components/parameters/Ticker" }], "responses": { "200": { "$ref": "#/components/responses/Stock" }, "default": { "$ref": "#/components/responses/Error" } } } },
    "/api/v1/stocks/{ticker}/quote": { "get": { "tags": ["Stocks"], "parameters": [{ "$ref": "#/components/parameters/Ticker" }, { "$ref": "#/components/parameters/DemoStatus" }], "responses": { "200": { "$ref": "#/components/responses/Quote" }, "default": { "$ref": "#/components/responses/Error" } } } },
    "/api/v1/stocks/{ticker}/chart": { "get": { "tags": ["Stocks"], "parameters": [{ "$ref": "#/components/parameters/Ticker" }], "responses": { "200": { "$ref": "#/components/responses/Chart" }, "default": { "$ref": "#/components/responses/Error" } } } },
    "/api/v1/stocks/{ticker}/flows": { "get": { "tags": ["Stocks"], "security": [{ "sessionCookie": [] }, { "demoMember": [] }], "parameters": [{ "$ref": "#/components/parameters/Ticker" }, { "$ref": "#/components/parameters/ListCursor" }], "responses": { "200": { "$ref": "#/components/responses/Flows" }, "default": { "$ref": "#/components/responses/Error" } } } },
    "/api/v1/stocks/{ticker}/news": { "get": { "tags": ["Stocks"], "parameters": [{ "$ref": "#/components/parameters/Ticker" }, { "$ref": "#/components/parameters/ListCursor" }], "responses": { "200": { "$ref": "#/components/responses/News" }, "default": { "$ref": "#/components/responses/Error" } } } },
    "/api/v1/stocks/{ticker}/financials": { "get": { "tags": ["Stocks"], "security": [{ "sessionCookie": [] }, { "demoMember": [] }], "parameters": [{ "$ref": "#/components/parameters/Ticker" }, { "$ref": "#/components/parameters/ListCursor" }], "responses": { "200": { "$ref": "#/components/responses/Financials" }, "default": { "$ref": "#/components/responses/Error" } } } },
    "/api/v1/stocks/{ticker}/signals": { "get": { "tags": ["Signals"], "security": [{ "sessionCookie": [] }, { "demoSubscriber": [] }, {}], "parameters": [{ "$ref": "#/components/parameters/Ticker" }], "responses": { "200": { "$ref": "#/components/responses/SignalEnvelope" }, "default": { "$ref": "#/components/responses/Error" } } } },
    "/api/v1/signals": { "get": { "tags": ["Signals"], "security": [{ "sessionCookie": [] }, { "demoSubscriber": [] }, {}], "parameters": [{ "$ref": "#/components/parameters/ListCursor" }], "responses": { "200": { "$ref": "#/components/responses/SignalList" }, "default": { "$ref": "#/components/responses/Error" } } } },
    "/api/v1/screener/conditions": { "get": { "tags": ["Screener"], "security": [{ "sessionCookie": [] }, { "demoMember": [] }], "responses": { "200": { "$ref": "#/components/responses/ScreenerConditions" }, "default": { "$ref": "#/components/responses/Error" } } } },
    "/api/v1/screener/query": { "post": { "tags": ["Screener"], "security": [{ "sessionCookie": [] }, { "demoMember": [] }], "parameters": [{ "$ref": "#/components/parameters/ListCursor" }, { "$ref": "#/components/parameters/CsrfToken" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ScreenerQuery" } } } }, "responses": { "200": { "$ref": "#/components/responses/ScreenerResult" }, "default": { "$ref": "#/components/responses/Error" } } } },
    "/api/v1/watchlists": { "get": { "tags": ["Watchlists"], "security": [{ "sessionCookie": [] }, { "demoMember": [] }], "parameters": [{ "$ref": "#/components/parameters/ListCursor" }], "responses": { "200": { "$ref": "#/components/responses/Watchlist" }, "default": { "$ref": "#/components/responses/Error" } } }, "post": { "tags": ["Watchlists"], "security": [{ "sessionCookie": [] }, { "demoMember": [] }], "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }, { "$ref": "#/components/parameters/CsrfToken" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/WatchlistMutation" } } } }, "responses": { "201": { "$ref": "#/components/responses/WatchlistMutation" }, "default": { "$ref": "#/components/responses/Error" } } } },
    "/api/v1/watchlists/{watchlistId}/items/{ticker}": { "delete": { "tags": ["Watchlists"], "security": [{ "sessionCookie": [] }, { "demoMember": [] }], "parameters": [{ "$ref": "#/components/parameters/WatchlistId" }, { "$ref": "#/components/parameters/Ticker" }, { "$ref": "#/components/parameters/IdempotencyKey" }, { "$ref": "#/components/parameters/CsrfToken" }], "responses": { "200": { "$ref": "#/components/responses/WatchlistMutation" }, "default": { "$ref": "#/components/responses/Error" } } } },
    "/api/v1/entitlements/me": { "get": { "tags": ["Subscriptions"], "security": [{ "sessionCookie": [] }, { "demoMember": [] }], "responses": { "200": { "$ref": "#/components/responses/Entitlements" }, "default": { "$ref": "#/components/responses/Error" } } } },
    "/api/v1/subscriptions/me": { "get": { "tags": ["Subscriptions"], "security": [{ "sessionCookie": [] }, { "demoMember": [] }], "responses": { "200": { "$ref": "#/components/responses/Subscription" }, "default": { "$ref": "#/components/responses/Error" } } } },
    "/api/v1/subscriptions/checkout": { "post": { "tags": ["Subscriptions"], "security": [{ "sessionCookie": [] }, { "demoMember": [] }], "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }, { "$ref": "#/components/parameters/CsrfToken" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Checkout" } } } }, "responses": { "202": { "$ref": "#/components/responses/Checkout" }, "default": { "$ref": "#/components/responses/Error" } } } },
    "/api/v1/subscriptions/cancel": { "post": { "tags": ["Subscriptions"], "security": [{ "sessionCookie": [] }, { "demoMember": [] }], "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }, { "$ref": "#/components/parameters/CsrfToken" }], "responses": { "200": { "$ref": "#/components/responses/Subscription" }, "default": { "$ref": "#/components/responses/Error" } } } },
    "/api/v1/webhooks/payment": { "post": { "tags": ["Subscriptions"], "parameters": [{ "$ref": "#/components/parameters/PaymentSignature" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PaymentWebhook" } } } }, "responses": { "200": { "$ref": "#/components/responses/Webhook" }, "409": { "$ref": "#/components/responses/Error" }, "503": { "$ref": "#/components/responses/Error" }, "default": { "$ref": "#/components/responses/Error" } } } },
    "/api/v1/stream": { "get": { "tags": ["Stream"], "security": [{ "sessionCookie": [] }, { "demoSubscriber": [] }], "parameters": [{ "$ref": "#/components/parameters/Ticker" }, { "$ref": "#/components/parameters/DemoGap" }, { "$ref": "#/components/parameters/ResumeStreamKey" }, { "$ref": "#/components/parameters/ResumeEpoch" }, { "$ref": "#/components/parameters/ResumeAfterSequence" }], "responses": { "200": { "description": "SSE stream", "content": { "text/event-stream": { "schema": { "type": "string" } } } }, "default": { "$ref": "#/components/responses/Error" } } } },
    "/api/v1/stream/replay": { "get": { "tags": ["Stream"], "security": [{ "sessionCookie": [] }, { "demoSubscriber": [] }], "parameters": [{ "$ref": "#/components/parameters/StreamKey" }, { "$ref": "#/components/parameters/Epoch" }, { "$ref": "#/components/parameters/AfterSequence" }], "responses": { "200": { "$ref": "#/components/responses/Replay" }, "default": { "$ref": "#/components/responses/Error" } } } }
  },
  "components": {
    "securitySchemes": {
      "demoMember": { "type": "apiKey", "in": "header", "name": "x-demo-role", "description": "Demo-only role header; production authentication is not implemented." },
      "demoSubscriber": { "type": "apiKey", "in": "header", "name": "x-demo-role", "description": "Demo-only subscriber role header; server entitlement remains authoritative in the demo store." },
      "sessionCookie": { "type": "apiKey", "in": "cookie", "name": "stock_session", "description": "HttpOnly server session cookie; production uses __Host-stock_session with Secure." }
    },
    "parameters": {
      "Ticker": { "name": "ticker", "in": "path", "required": true, "schema": { "type": "string", "pattern": "^[0-9]{6}$" } },
      "WatchlistId": { "name": "watchlistId", "in": "path", "required": true, "schema": { "type": "string", "minLength": 1, "maxLength": 128 } },
      "SearchQuery": { "name": "q", "in": "query", "required": false, "schema": { "type": "string", "minLength": 1, "maxLength": 50 } },
      "ListCursor": { "name": "cursor", "in": "query", "required": false, "schema": { "type": "string", "minLength": 16, "maxLength": 1024 }, "description": "서버 서명·조회 범위 결합 opaque cursor" },
      "DemoStatus": { "name": "demoStatus", "in": "query", "schema": { "$ref": "#/components/schemas/DataStatus" } },
      "DemoGap": { "name": "demoGap", "in": "query", "schema": { "type": "string", "enum": ["0", "1"] } },
      "ResumeStreamKey": { "name": "streamKey", "in": "query", "required": false, "schema": { "type": "string", "pattern": "^signal:[0-9]{6}:default$" }, "description": "재연결 시 이전 cursor의 streamKey. epoch/afterSequence와 함께 보내야 합니다." },
      "ResumeEpoch": { "name": "epoch", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }, "description": "재연결 시 이전 cursor의 epoch; JavaScript 안전 정수 범위" },
      "ResumeAfterSequence": { "name": "afterSequence", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }, "description": "재연결 시 마지막 정상 수신 sequence; JavaScript 안전 정수 범위" },
      "StreamKey": { "name": "streamKey", "in": "query", "required": true, "schema": { "type": "string", "pattern": "^signal:[0-9]{6}:default$" } },
      "Epoch": { "name": "epoch", "in": "query", "required": true, "schema": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 } },
      "AfterSequence": { "name": "afterSequence", "in": "query", "required": true, "schema": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 } },
      "IdempotencyKey": { "name": "Idempotency-Key", "in": "header", "required": true, "schema": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{8,128}$" } },
      "MetricsToken": { "name": "x-metrics-token", "in": "header", "required": false, "schema": { "type": "string" }, "description": "샌드박스에서는 선택 사항이며, 운영에서는 INTERNAL_METRICS_TOKEN에 해당하는 값이 필요합니다." },
      "PaymentSignature": { "name": "x-payment-signature", "in": "header", "required": true, "schema": { "type": "string", "pattern": "^t=[0-9]{1,12},v1=[a-f0-9]{64}$" }, "description": "sandbox 서명 형식: t=Unix timestamp,v1=HMAC-SHA256(timestamp.body); 허용 시각 오차는 PAYMENT_WEBHOOK_TOLERANCE_SECONDS로 제한합니다." },
      "CsrfToken": { "name": "x-csrf-token", "in": "header", "required": false, "schema": { "type": "string", "minLength": 20 }, "description": "sessionCookie 인증을 사용하는 mutation에서는 필수입니다. demoMember 인증에서는 sandbox 요청에 한해 생략할 수 있습니다." }
    },
    "schemas": {
      "DataStatus": { "type": "string", "enum": ["REALTIME", "DELAYED", "STALE", "UNAVAILABLE"] },
      "Readiness": { "type": "object", "required": ["status", "mode", "checks", "requestId"], "properties": { "status": { "type": "string", "enum": ["ready", "not_ready"] }, "mode": { "type": "string", "enum": ["sandbox", "production"] }, "checks": { "type": "object", "required": ["outboxWorker", "authProvider", "marketProvider", "paymentWebhook", "originAllowlist", "metrics"], "properties": { "outboxWorker": { "type": "object", "required": ["status", "active", "inFlight", "consecutiveFailures"], "properties": { "status": { "type": "string", "enum": ["ready", "not_ready"] }, "active": { "type": "boolean" }, "inFlight": { "type": "integer", "minimum": 0 }, "lastRunAt": { "type": ["string", "null"], "format": "date-time" }, "lastSuccessAt": { "type": ["string", "null"], "format": "date-time" }, "lastErrorAt": { "type": ["string", "null"], "format": "date-time" }, "lastErrorCode": { "type": ["string", "null"] }, "consecutiveFailures": { "type": "integer", "minimum": 0 } } }, "authProvider": { "type": "object", "required": ["status", "kind"], "properties": { "status": { "type": "string", "enum": ["ready", "sandbox", "not_ready"] }, "kind": { "type": "string" } } }, "marketProvider": { "type": "object", "required": ["status", "kind"], "properties": { "status": { "type": "string", "enum": ["ready", "sandbox", "not_ready"] }, "kind": { "type": "string" } } }, "paymentWebhook": { "type": "object", "required": ["status", "configured"], "properties": { "status": { "type": "string", "enum": ["ready", "sandbox", "not_ready"] }, "configured": { "type": "boolean" } } }, "originAllowlist": { "type": "object", "required": ["status", "configured"], "properties": { "status": { "type": "string", "enum": ["ready", "sandbox", "not_ready"] }, "configured": { "type": "boolean" } } }, "metrics": { "type": "object", "required": ["status", "configured"], "properties": { "status": { "type": "string", "enum": ["ready", "sandbox", "not_ready"] }, "configured": { "type": "boolean" } } } } }, "reasons": { "type": "array", "items": { "type": "string" } }, "requestId": { "type": "string" }, "traceId": { "type": "string" } } },
      "SignalStatus": { "type": "string", "enum": ["ACTIVE", "SUSPENDED", "EXPIRED", "CANCELLED", "VALIDATING"] },
      "Direction": { "type": "string", "enum": ["BUY", "SELL", "NEUTRAL"] },
      "Cursor": { "type": "object", "required": ["streamKey", "epoch", "sequence"], "properties": { "streamKey": { "type": "string" }, "epoch": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }, "sequence": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 } } },
      "Evidence": { "type": "object", "required": ["type", "label", "value"], "properties": { "type": { "type": "string" }, "label": { "type": "string" }, "value": {} } },
      "Stock": { "type": "object", "required": ["ticker", "name", "exchange", "securityType", "tradingStatus"], "properties": { "ticker": { "type": "string" }, "name": { "type": "string" }, "exchange": { "type": "string" }, "marketType": { "type": "string" }, "securityType": { "type": "string", "const": "COMMON_STOCK" }, "tradingStatus": { "type": "string" }, "sector": { "type": "string" } } },
      "Quote": { "type": "object", "required": ["ticker", "price", "change", "changeRate", "volume", "asOf", "receivedAt", "dataStatus", "source"], "properties": { "ticker": { "type": "string" }, "name": { "type": "string" }, "price": { "type": "number" }, "change": { "type": "number" }, "changeRate": { "type": "number" }, "volume": { "type": "integer" }, "asOf": { "type": "string", "format": "date-time" }, "receivedAt": { "type": "string", "format": "date-time" }, "dataStatus": { "$ref": "#/components/schemas/DataStatus" }, "staleAfter": { "type": "string", "format": "date-time" }, "source": { "type": "string" } } }, "QuoteResponse": { "allOf": [{ "$ref": "#/components/schemas/Quote" }, { "type": "object", "required": ["requestId", "traceId"], "properties": { "requestId": { "type": "string" }, "traceId": { "type": "string" } } }] },
      "SignalPreview": { "type": "object", "additionalProperties": false, "required": ["ticker", "locked", "previewLabel", "protectedFields"], "properties": { "ticker": { "type": "string" }, "name": { "type": "string" }, "locked": { "const": true }, "previewLabel": { "type": "string" }, "dataStatus": { "$ref": "#/components/schemas/DataStatus" }, "asOf": { "type": "string", "format": "date-time" }, "source": { "type": "string" }, "protectedFields": { "type": "array", "items": { "type": "string" } } }, "allOf": [{ "not": { "required": ["direction"] } }, { "not": { "required": ["strength"] } }, { "not": { "required": ["occurredAt"] } }, { "not": { "required": ["publishedAt"] } }, { "not": { "required": ["algorithmVersion"] } }, { "not": { "required": ["evidence"] } }] },
      "Signal": { "type": "object", "additionalProperties": false, "required": ["eventId", "streamKey", "epoch", "sequence", "ticker", "strategyKey", "direction", "status", "dataStatus", "strength", "occurredAt", "publishedAt", "asOf", "validUntil", "lastHeartbeatAt", "lastEvaluatedAt", "staleAfter", "healthReason", "algorithmVersion", "evidence", "riskDisclosureId"], "properties": { "eventId": { "type": "string" }, "streamKey": { "type": "string" }, "epoch": { "type": "integer" }, "sequence": { "type": "integer" }, "ticker": { "type": "string" }, "strategyKey": { "const": "default" }, "direction": { "$ref": "#/components/schemas/Direction" }, "status": { "$ref": "#/components/schemas/SignalStatus" }, "effectiveStatus": { "$ref": "#/components/schemas/SignalStatus", "description": "독립 watchdog가 heartbeat/evaluation 상태를 반영한 표시 상태" }, "dataStatus": { "$ref": "#/components/schemas/DataStatus" }, "strength": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH"] }, "occurredAt": { "type": "string", "format": "date-time" }, "publishedAt": { "type": "string", "format": "date-time" }, "asOf": { "type": "string", "format": "date-time" }, "validUntil": { "type": ["string", "null"], "format": "date-time" }, "lastHeartbeatAt": { "type": "string", "format": "date-time" }, "lastEvaluatedAt": { "type": "string", "format": "date-time" }, "staleAfter": { "type": "string", "format": "date-time" }, "healthReason": { "type": "string" }, "algorithmVersion": { "type": "string" }, "evidence": { "type": "array", "items": { "$ref": "#/components/schemas/Evidence" } }, "riskDisclosureId": { "type": "string" } } },
      "ScreenerQuery": { "type": "object", "additionalProperties": false, "properties": { "market": { "type": "string", "enum": ["ALL", "KOSPI", "KOSDAQ"], "default": "ALL" }, "priceChange": { "type": "string", "enum": ["ANY", "UP", "DOWN"], "default": "ANY" }, "volume": { "type": "string", "enum": ["ANY", "HIGH"], "default": "ANY" } } },
      "WatchlistMutation": { "type": "object", "required": ["ticker"], "additionalProperties": false, "properties": { "ticker": { "type": "string", "pattern": "^[0-9]{6}$" } } },
      "Checkout": { "type": "object", "additionalProperties": false, "properties": { "plan": { "type": "string", "const": "ALGORITHM_SIGNAL_MONTHLY" } } },
      "PaymentWebhook": { "type": "object", "required": ["provider", "providerEventId", "userId", "revision", "eventType"], "additionalProperties": false, "properties": { "provider": { "type": "string" }, "providerEventId": { "type": "string" }, "userId": { "type": "string" }, "revision": { "type": "integer", "minimum": 1 }, "eventType": { "type": "string", "enum": ["payment.succeeded", "payment.failed", "subscription.cancelled", "refund.pending", "refund.completed", "subscription.suspended", "subscription.expired"] }, "endsAt": { "type": "string", "format": "date-time" }, "cancelAt": { "type": "string", "format": "date-time" }, "failureReason": { "type": "string", "maxLength": 256 } } },
      "DemoSessionRequest": { "type": "object", "required": ["userId"], "additionalProperties": false, "properties": { "userId": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,64}$" } } },
      "AuthMe": { "type": "object", "required": ["authenticated", "requestId"], "properties": { "authenticated": { "type": "boolean" }, "userId": { "type": "string" }, "role": { "type": "string", "enum": ["member", "subscriber"] }, "csrfToken": { "type": "string", "description": "세션 mutation에 사용하는 비밀 저장 대상이 아닌 CSRF 토큰" }, "expiresAt": { "type": "string", "format": "date-time" }, "provider": { "type": "string" } } },
      "Subscription": { "type": "object", "required": ["status"], "properties": { "status": { "type": "string", "enum": ["PENDING", "ACTIVE", "CANCELLATION_SCHEDULED", "REFUND_PENDING", "REFUNDED", "PAYMENT_FAILED", "EXPIRED", "SUSPENDED"] }, "autoRenew": { "type": "boolean" }, "startedAt": { "type": ["string", "null"], "format": "date-time" }, "endsAt": { "type": ["string", "null"], "format": "date-time" } } },
      "SignalSnapshot": { "type": "object", "required": ["snapshotCursor", "item"], "properties": { "snapshotCursor": { "$ref": "#/components/schemas/Cursor" }, "item": { "$ref": "#/components/schemas/Signal" } } },
      "SignalRevision": { "type": "object", "additionalProperties": false, "required": ["revision", "eventId", "inputAsOf", "algorithmVersion", "evaluationStatus", "evidenceSnapshot", "createdAt"], "properties": { "revision": { "type": "integer", "minimum": 1 }, "eventId": { "type": "string" }, "inputAsOf": { "type": "string", "format": "date-time" }, "algorithmVersion": { "type": "string" }, "evaluationStatus": { "$ref": "#/components/schemas/SignalStatus" }, "evidenceSnapshot": { "type": "array", "items": { "$ref": "#/components/schemas/Evidence" } }, "createdAt": { "type": "string", "format": "date-time" } } },
      "SignalHistory": { "type": "object", "additionalProperties": false, "required": ["events", "revisions"], "properties": { "events": { "type": "array", "items": { "$ref": "#/components/schemas/Signal" } }, "revisions": { "type": "array", "items": { "$ref": "#/components/schemas/SignalRevision" } } } },
      "Error": { "type": "object", "required": ["error", "requestId"], "properties": { "error": { "type": "object", "required": ["code", "message"], "properties": { "code": { "type": "string" }, "message": { "type": "string" }, "details": {} } }, "requestId": { "type": "string" }, "traceId": { "type": "string" } } }
    },
    "responses": {
      "Error": { "description": "공통 오류 envelope", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "MarketOverview": { "description": "시장 개요", "content": { "application/json": { "schema": { "type": "object", "required": ["session", "asOf", "dataStatus", "requestId"] } } } },
      "StockSearch": { "description": "종목 검색 결과", "content": { "application/json": { "schema": { "type": "object", "required": ["items", "nextCursor", "asOf", "dataStatus", "requestId"] } } } },
      "Stock": { "description": "종목 기본 정보와 quote", "content": { "application/json": { "schema": { "type": "object", "required": ["stock", "quote", "requestId"], "properties": { "stock": { "$ref": "#/components/schemas/Stock" }, "quote": { "$ref": "#/components/schemas/Quote" } } } } } },
      "Quote": { "description": "최신 시세", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/QuoteResponse" } } } },
      "Chart": { "description": "차트 시계열", "content": { "application/json": { "schema": { "type": "object", "required": ["items", "asOf", "dataStatus", "requestId"] } } } },
      "Flows": { "description": "수급", "content": { "application/json": { "schema": { "type": "object", "required": ["items", "nextCursor", "asOf", "dataStatus", "requestId"] } } } },
      "News": { "description": "뉴스", "content": { "application/json": { "schema": { "type": "object", "required": ["items", "nextCursor", "asOf", "dataStatus", "requestId"] } } } },
      "Financials": { "description": "재무", "content": { "application/json": { "schema": { "type": "object", "required": ["items", "nextCursor", "asOf", "dataStatus", "requestId"] } } } },
      "SignalEnvelope": { "description": "권한별 종목 신호", "content": { "application/json": { "schema": { "type": "object", "required": ["locked", "items", "nextCursor", "asOf", "dataStatus", "requestId"], "properties": { "locked": { "type": "boolean" }, "item": { "oneOf": [{ "$ref": "#/components/schemas/SignalPreview" }, { "$ref": "#/components/schemas/Signal" }] }, "items": { "type": "array" }, "nextCursor": { "type": ["string", "null"] }, "asOf": { "type": "string", "format": "date-time" }, "dataStatus": { "$ref": "#/components/schemas/DataStatus" }, "history": { "$ref": "#/components/schemas/SignalHistory" }, "snapshotCursor": { "$ref": "#/components/schemas/Cursor" } } } } } },
      "SignalList": { "description": "권한별 신호 목록", "content": { "application/json": { "schema": { "type": "object", "required": ["locked", "items", "nextCursor", "asOf", "dataStatus", "requestId"] } } } },
      "ScreenerConditions": { "description": "승인된 조건 메타데이터", "content": { "application/json": { "schema": { "type": "object", "required": ["items", "asOf", "dataStatus", "requestId"] } } } },
      "ScreenerResult": { "description": "스크리너 결과", "content": { "application/json": { "schema": { "type": "object", "required": ["items", "nextCursor", "query", "asOf", "dataStatus", "requestId"] } } } },
      "Watchlist": { "description": "관심목록", "content": { "application/json": { "schema": { "type": "object", "required": ["items", "watchlistId", "nextCursor", "asOf", "dataStatus", "requestId"] } } } },
      "WatchlistMutation": { "description": "관심목록 mutation 결과", "content": { "application/json": { "schema": { "type": "object", "required": ["watchlistId", "ticker", "requestId"] } } } },
      "Entitlements": { "description": "본인 entitlement", "content": { "application/json": { "schema": { "type": "object", "required": ["items", "asOf", "requestId"] } } } },
      "Subscription": { "description": "본인 구독", "content": { "application/json": { "schema": { "type": "object", "required": ["subscription", "asOf", "requestId"], "properties": { "subscription": { "$ref": "#/components/schemas/Subscription" }, "asOf": { "type": "string", "format": "date-time" } } } } } },
      "Checkout": { "description": "결제 처리중", "content": { "application/json": { "schema": { "type": "object", "required": ["subscription", "message", "requestId"] } } } },
      "Webhook": { "description": "웹훅 처리 결과", "content": { "application/json": { "schema": { "type": "object", "required": ["result", "requestId"] } } } },
      "Replay": { "description": "연속 replay 또는 권한 검증된 snapshot fallback 지시", "content": { "application/json": { "schema": { "type": "object", "required": ["streamKey", "epoch", "afterSequence", "replayable", "events", "requestId"], "properties": { "streamKey": { "type": "string" }, "epoch": { "type": "integer" }, "afterSequence": { "type": "integer" }, "replayable": { "type": "boolean" }, "events": { "type": "array", "items": { "$ref": "#/components/schemas/Signal" } }, "resyncReason": { "type": "string" }, "snapshot": { "$ref": "#/components/schemas/SignalSnapshot" } } } } } },
      "AuthSession": { "description": "sandbox session creation response; token is only set in an HttpOnly cookie", "content": { "application/json": { "schema": { "type": "object", "required": ["authenticated", "userId", "role", "csrfToken", "expiresAt", "requestId"], "properties": { "authenticated": { "const": true }, "userId": { "type": "string" }, "role": { "type": "string", "const": "member" }, "csrfToken": { "type": "string" }, "expiresAt": { "type": "string", "format": "date-time" }, "provider": { "type": "string" } } } } } },
      "AuthMe": { "description": "현재 세션 상태", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AuthMe" } } } }
    }
  }
